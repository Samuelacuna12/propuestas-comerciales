<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="{{ settings.d_paper }}"><link rel="canonical" href="{{ canonical_url }}">{% if settings.favicon %}<link rel="icon" href="{{ settings.favicon | image_url:width:32,height:32 }}">{% endif %}{% assign meta_title = page_title %}{% if request.page_type == 'index' %}{% assign meta_title = settings.home_seo_title %}{% endif %}<title>{{ meta_title | escape }}{% unless meta_title contains shop.name %} · {{ shop.name | escape }}{% endunless %}</title>{% assign seo_description = page_description | default: shop.description %}{% if request.page_type == 'index' %}{% assign seo_description = settings.home_seo_description %}{% endif %}{% if seo_description != blank %}<meta name="description" content="{{ seo_description | strip_html | escape }}">{% endif %}<meta property="og:site_name" content="{{ shop.name | escape }}"><meta property="og:title" content="{{ meta_title | escape }}"><meta property="og:description" content="{{ seo_description | strip_html | escape }}"><meta property="og:url" content="{{ canonical_url }}"><meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">{% assign social_image = page_image | default: settings.logo %}{% if social_image %}<meta property="og:image" content="https:{{ social_image | image_url:width:1200 }}">{% endif %}<meta name="twitter:card" content="summary_large_image">{% if request.page_type == 'search' %}<meta name="robots" content="noindex,follow">{% endif %}<link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin><link rel="preconnect" href="https://cdn.shopify.com" crossorigin>{{ 'dolce.css' | asset_url | stylesheet_tag }}<style>{{ settings.type_body_font | font_face: font_display:'swap' }}:root{--d-body:{{ settings.type_body_font.family }},{{ settings.type_body_font.fallback_families }};--d-display:{{ settings.display_font }},'Times New Roman',serif;--d-paper:{{ settings.d_paper }};--d-ink:{{ settings.d_ink }};--d-accent:{{ settings.d_accent }};--d-blush:{{ settings.d_blush }};--d-line:{{ settings.d_line }};--d-muted:{{ settings.d_muted }}}</style>{{ content_for_header }}<script src="{{ 'dolce.js' | asset_url }}" defer></script><script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":{{ shop.name | json }},"url":{{ shop.url | json }}{% if settings.logo %},"logo":{{ settings.logo | image_url:width:400 | prepend:'https:' | json }}{% endif %},"sameAs":[{{ settings.social_instagram_link | json }},{{ settings.social_tiktok_link | json }}]}</script></head><body class="d-page-type-{{ request.page_type }}"><a href="#MainContent" class="d-visually-hidden">{{ 'dolce.skip' | t }}</a>{% sections 'header-group' %}<main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>{% sections 'footer-group' %}<div id="sr-announcer" class="d-visually-hidden" aria-live="polite" aria-atomic="true"></div></body></html>

{% doc %}
  Product-specific editorial, official photography and brand media.
  @param {product} product - Current product
  @param {block} story - Merchant-editable story
  @param gallery - Ordered product media
{% enddoc %}
{{ 'dolce-sales-story.css' | asset_url | stylesheet_tag }}
{% assign community_alt = 'dolce.sales.community_alt' | t %}
{% if story.settings.sales_heading1 != blank %}
  <script src="{{ 'dolce-editorial-motion.js' | asset_url }}" defer></script>
  {%- capture front_data -%}{% render 'dolce-atelier-profile', handle: product.handle, view: 'front' %}{%- endcapture -%}
  {%- capture reverse_data -%}{% render 'dolce-atelier-profile', handle: product.handle, view: 'reverse' %}{%- endcapture -%}
  {%- capture scene_name -%}{% render 'dolce-atelier-profile', handle: product.handle, view: 'scene' %}{%- endcapture -%}
  {% liquid
    assign front = front_data | strip | split: '~'
    assign reverse = reverse_data | strip | split: '~'
    assign scene_name = scene_name | strip
    assign front_photo = nil
    assign reverse_photo = nil
    assign scene_photo = nil
    for photograph in product.images
      assign filename = photograph.src | split: '?' | first | split: '/' | last
      if filename == front[0]
        assign front_photo = photograph
      elsif filename == reverse[0]
        assign reverse_photo = photograph
      elsif filename == scene_name
        assign scene_photo = photograph
      endif
    endfor
    if front_photo == blank
      assign front = nil
      assign front_photo = gallery[0].preview_image
    endif
    if reverse_photo == blank
      assign reverse = nil
      assign reverse_photo = gallery[1].preview_image
    endif
    assign plate_one = story.settings.detail_image_one | default: front_photo
    assign plate_two = story.settings.detail_image_two | default: reverse_photo
    assign plate_one_profile = front
    assign plate_two_profile = reverse
    if story.settings.detail_image_one != blank
      assign plate_one_profile = nil
    endif
    if story.settings.detail_image_two != blank
      assign plate_two_profile = nil
    endif
    assign scene_photo = story.settings.sales_editorial | default: scene_photo
    assign story_id = 'DolceAtelier-' | append: section.id | append: '-' | append: product.id
    assign detail_a = story_id | append: '-A'
    assign detail_b = story_id | append: '-B'
    assign fallback_title = 'dolce.details' | t
  %}
  <dolce-atelier-reader class="d-atelier" role="region" aria-labelledby="{{ story_id }}-heading"
    {% if settings.editorial_canvas != blank %}style="--atelier-paper:url('{{ settings.editorial_canvas | image_url: width: 1600 }}')"{% endif %}>
    <nav class="d-atelier-rail" aria-label="{{ 'dolce.sales.editorial_navigation' | t | escape }}">
      <div class="d-atelier-rail__inner">
        <span class="d-atelier-rail__name">{{ product.title | escape }}</span>
        <div class="d-atelier-rail__links">
          <a href="#{{ story_id }}-silhouette" data-atelier-jump="silhouette">{{ 'dolce.sales.silhouette' | t }}</a>
          <a href="#{{ story_id }}-details" data-atelier-jump="details">{{ 'dolce.details' | t }}</a>
        </div>
      </div>
      <span class="d-atelier-rail__progress" aria-hidden="true"></span>
    </nav>
    <div class="d-atelier__sheet">
      <div class="d-atelier-opening" id="{{ story_id }}-silhouette" data-atelier-chapter="silhouette">
        <span class="d-atelier-opening__word" aria-hidden="true">Dolce</span>
        <header class="d-atelier-opening__copy">
          <p class="d-atelier-kicker">{{ 'dolce.sales.look_closer' | t }}</p>
          <h2 id="{{ story_id }}-heading">{{ story.settings.sales_heading1 | escape }}</h2>
        </header>
        {% render 'dolce-atelier-view', photo: front_photo, profile: front, view: 'front', detail_id: detail_a, letter: 'A', product_name: product.title %}
        {% render 'dolce-atelier-view', photo: reverse_photo, profile: reverse, view: 'reverse', detail_id: detail_b, letter: 'B', product_name: product.title %}
        <div class="d-atelier-opening__note"><p>{{ story.settings.sales_text1 | escape }}</p></div>
      </div>
      <div class="d-atelier-study{% unless scene_photo %} d-atelier-study--two-views{% endunless %}" id="{{ story_id }}-details" data-atelier-chapter="details">
        <h3 class="d-visually-hidden">{{ 'dolce.details' | t }}</h3>
        {% render 'dolce-atelier-detail', photo: plate_one, profile: plate_one_profile, detail_id: detail_a, letter: 'A', fallback_title: fallback_title, fallback_copy: story.settings.sales_text1 %}
        {% if scene_photo %}
          <figure class="d-atelier-study__scene">
            <button type="button" data-zoom="{{ scene_photo | image_url: width: 2000 }}" data-zoom-alt="{{ product.title | escape }}" aria-label="{{ 'dolce.product.zoom' | t | escape }} · {{ product.title | escape }}">
              {{ scene_photo | image_url: width: 900 | image_tag: widths: '300,450,650,900', sizes: '(min-width: 1050px) 360px, 44vw', loading: 'lazy', alt: product.title }}
            </button>
          </figure>
        {% endif %}
        {% render 'dolce-atelier-detail', photo: plate_two, profile: plate_two_profile, detail_id: detail_b, letter: 'B', fallback_title: fallback_title, fallback_copy: story.settings.sales_text2 %}
        <div class="d-atelier-study__copy">
          {% if story.settings.sales_heading2 != blank %}<h3>{{ story.settings.sales_heading2 | escape }}</h3>{% endif %}
          {% if story.settings.sales_text2 != blank %}<p>{{ story.settings.sales_text2 | escape }}</p>{% endif %}
          <a class="d-atelier-buy" href="#DolceProduct-{{ section.id }}">{{ 'dolce.sales.return_options' | t }} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </dolce-atelier-reader>
{% endif %}
{% if settings.brand_film_url != blank %}
<section class="d-sales-backstage" aria-labelledby="DolceBackstageHeading-{{ product.id }}">
 <div class="d-wrap d-sales-backstage__grid">
  <div class="d-sales-backstage__copy"><p class="d-sales-label">{{ 'dolce.sales.official_film' | t }}</p><h2 id="DolceBackstageHeading-{{ product.id }}">{{ 'dolce.sales.film_heading' | t }}</h2><p>{{ 'dolce.sales.film_text' | t }}</p><p class="d-sales-backstage__note">{{ 'dolce.sales.film_context' | t }}</p><a href="https://www.tiktok.com/@dolcelingerie1/video/7470182443706748165" class="d-text-link" target="_blank" rel="noopener">{{ 'dolce.sales.film_source' | t }}</a></div>
  <div class="d-sales-backstage__media"><video controls playsinline preload="none"{% if settings.brand_film_poster %} poster="{{ settings.brand_film_poster | image_url:width:650 }}"{% endif %} aria-label="{{ 'dolce.sales.film_heading' | t }}"><source src="{{ settings.brand_film_url }}" type="video/mp4"></video><span class="d-sales-backstage__word" aria-hidden="true">Dolce.</span></div>
 </div>
</section>
{% endif %}
{% if settings.proof_image1 != blank or settings.proof_image2 != blank %}
<section class="d-sales-community" aria-labelledby="DolceCommunityHeading-{{ product.id }}">
 <div class="d-wrap"><header class="d-sales-community__heading"><div><p class="d-sales-label">{{ 'dolce.sales.community_label' | t }}</p><h2 id="DolceCommunityHeading-{{ product.id }}">{{ 'dolce.sales.community_heading' | t }}</h2></div><p>{{ 'dolce.sales.community_text' | t }}</p></header>
 <div class="d-sales-community__images">{% if settings.proof_image1 %}<figure><button type="button" data-zoom="{{ settings.proof_image1 | image_url:width:2000 }}" data-zoom-alt="{{ community_alt | escape }}" aria-label="{{ 'dolce.sales.read_messages' | t }}">{{ settings.proof_image1 | image_url:width:1100 | image_tag: loading:'lazy', widths:'390,585,800,1100', sizes:'(min-width:900px) 45vw,100vw', alt:community_alt }}</button><figcaption>{{ 'dolce.sales.community_caption' | t }}</figcaption></figure>{% endif %}{% if settings.proof_image2 %}<figure><button type="button" data-zoom="{{ settings.proof_image2 | image_url:width:2000 }}" data-zoom-alt="{{ community_alt | escape }}" aria-label="{{ 'dolce.sales.read_messages' | t }}">{{ settings.proof_image2 | image_url:width:1100 | image_tag: loading:'lazy', widths:'390,585,800,1100', sizes:'(min-width:900px) 45vw,100vw', alt:community_alt }}</button><figcaption>{{ 'dolce.sales.community_caption' | t }}</figcaption></figure>{% endif %}</div>
 </div>
</section>
{% endif %}

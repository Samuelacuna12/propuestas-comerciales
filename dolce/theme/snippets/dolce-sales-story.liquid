{% doc %}
Renders product-specific editorial photography, native sales copy and official brand media.
@param {product} product - Current product
@param {block} story - Matching merchant-editable product story
@param gallery - Ordered product media
{% enddoc %}
{{ 'dolce-sales-story.css' | asset_url | stylesheet_tag }}
{% liquid
 assign detail_one = story.settings.detail_image_one
 assign detail_two = story.settings.detail_image_two
 if detail_one == blank
  assign detail_one = gallery[1].preview_image | default:gallery[0].preview_image
 endif
 if detail_two == blank
  assign detail_two = gallery[2].preview_image | default:gallery[0].preview_image
 endif
 assign editorial = story.settings.sales_editorial
 assign detail_alt = product.title | append:' · Dolce Lingerie'
 assign community_alt = 'dolce.sales.community_alt' | t
%}
{% if story.settings.sales_heading1 != blank %}
<section class="d-sales-editorial{% if editorial %} d-sales-editorial--composite{% endif %}" style="--d-editorial-canvas:url('{{ settings.editorial_canvas | image_url: width: 1200 }}')" aria-labelledby="DolceNarrativeOne-{{ product.id }}">
 <div class="d-wrap d-sales-editorial__inner">
  <span class="d-sales-editorial__watermark" aria-hidden="true">DOLCE</span>
  <header class="d-sales-editorial__header"><p class="d-sales-label">{{ 'dolce.sales.look_closer' | t }}<span>{{ product.title | escape }}</span></p><h2 id="DolceNarrativeOne-{{ product.id }}">{{ story.settings.sales_heading1 | escape }}</h2></header>
  {% if editorial %}
   <div class="d-sales-composite"><button type="button" data-zoom="{{ editorial | image_url:width:2400 }}" data-zoom-alt="{{ detail_alt | escape }}" aria-label="{{ 'dolce.product.zoom' | t }}">{{ editorial | image_url:width:1600 | image_tag: loading:'lazy', widths:'390,585,800,1200,1600', sizes:'(min-width:1552px) 1440px,100vw', alt:detail_alt }}<span class="d-sales-editorial__zoom" aria-hidden="true">+</span></button></div>
  {% else %}
   <div class="d-sales-collage">
    {% if detail_one %}<figure class="d-sales-collage__first"><button type="button" data-zoom="{{ detail_one | image_url:width:2000 }}" data-zoom-alt="{{ detail_alt | escape }}" aria-label="{{ 'dolce.product.zoom' | t }}">{{ detail_one | image_url:width:1100 | image_tag: loading:'lazy', widths:'390,585,800,1100', sizes:'(min-width:900px) 49vw,60vw', alt:detail_alt }}<span class="d-sales-editorial__zoom" aria-hidden="true">+</span></button><figcaption>{{ product.title | escape }}<span>Dolce Lingerie</span></figcaption></figure>{% endif %}
    {% if detail_two %}<figure class="d-sales-collage__second"><button type="button" data-zoom="{{ detail_two | image_url:width:2000 }}" data-zoom-alt="{{ detail_alt | escape }}" aria-label="{{ 'dolce.product.zoom' | t }}">{{ detail_two | image_url:width:1000 | image_tag: loading:'lazy', widths:'390,585,800,1000', sizes:'(min-width:900px) 43vw,57vw', alt:detail_alt }}<span class="d-sales-editorial__zoom" aria-hidden="true">+</span></button></figure>{% endif %}
    {% if detail_one %}<figure class="d-sales-collage__detail">{{ detail_one | image_url:width:700 | image_tag: loading:'lazy', widths:'240,350,500,700', sizes:'(min-width:900px) 22vw,32vw', alt:detail_alt }}<figcaption>{{ 'dolce.sales.made_of_details' | t }}</figcaption></figure>{% endif %}
    <span class="d-sales-collage__vertical" aria-hidden="true">DOLCE LINGERIE</span>
   </div>
  {% endif %}
  <div class="d-sales-editorial__captions">
   <div class="d-sales-editorial__caption d-sales-editorial__caption--first"><span class="d-sales-editorial__index" aria-hidden="true">01</span><p>{{ story.settings.sales_text1 | escape }}</p><a href="#DolcePdp-{{ section.id }}" class="d-text-link">{{ 'dolce.sales.return_options' | t }}</a></div>
   {% if story.settings.sales_heading2 != blank %}<div class="d-sales-editorial__caption d-sales-editorial__caption--second"><span class="d-sales-editorial__index" aria-hidden="true">02</span><h3>{{ story.settings.sales_heading2 | escape }}</h3><p>{{ story.settings.sales_text2 | escape }}</p>{% if section.settings.whatsapp_url != blank %}<a href="{{ section.settings.whatsapp_url }}" class="d-text-link" target="_blank" rel="noopener">{{ 'dolce.sales.ask_dolce' | t }}</a>{% endif %}</div>{% endif %}
  </div>
 </div>
</section>
{% endif %}
{% if settings.brand_film_url != blank %}
<section class="d-sales-backstage" aria-labelledby="DolceBackstageHeading-{{ product.id }}">
 <div class="d-wrap d-sales-backstage__grid">
  <div class="d-sales-backstage__copy"><p class="d-sales-label">{{ 'dolce.sales.official_film' | t }}</p><h2 id="DolceBackstageHeading-{{ product.id }}">{{ 'dolce.sales.film_heading' | t }}</h2><p>{{ 'dolce.sales.film_text' | t }}</p><p class="d-sales-backstage__note">{{ 'dolce.sales.film_context' | t }}</p><a href="https://www.tiktok.com/@dolcelingerie1/video/7470182443706748165" class="d-text-link" target="_blank" rel="noopener">{{ 'dolce.sales.film_source' | t }}</a></div>
  <div class="d-sales-backstage__media"><video controls playsinline preload="none"{% if settings.brand_film_poster %} poster="{{ settings.brand_film_poster | image_url:width:650 }}"{% endif %} aria-label="{{ 'dolce.sales.film_heading' | t }}"><source src="{{ settings.brand_film_url }}" type="video/mp4"></video><span class="d-sales-backstage__word" aria-hidden="true">Dolce.</span></div>
 </div>
</section>
{% endif %}
{% if settings.proof_image1 != blank or settings.proof_image2 != blank %}
<section class="d-sales-community" aria-labelledby="DolceCommunityHeading-{{ product.id }}">
 <div class="d-wrap"><header class="d-sales-community__heading"><div><p class="d-sales-label">{{ 'dolce.sales.community_label' | t }}</p><h2 id="DolceCommunityHeading-{{ product.id }}">{{ 'dolce.sales.community_heading' | t }}</h2></div><p>{{ 'dolce.sales.community_text' | t }}</p></header>
 <div class="d-sales-community__images">{% if settings.proof_image1 %}<figure><button type="button" data-zoom="{{ settings.proof_image1 | image_url:width:2000 }}" data-zoom-alt="{{ community_alt | escape }}" aria-label="{{ 'dolce.sales.read_messages' | t }}">{{ settings.proof_image1 | image_url:width:1100 | image_tag: loading:'lazy', widths:'390,585,800,1100', sizes:'(min-width:900px) 45vw,100vw', alt:community_alt }}</button><figcaption>{{ 'dolce.sales.community_caption' | t }}</figcaption></figure>{% endif %}{% if settings.proof_image2 %}<figure><button type="button" data-zoom="{{ settings.proof_image2 | image_url:width:2000 }}" data-zoom-alt="{{ community_alt | escape }}" aria-label="{{ 'dolce.sales.read_messages' | t }}">{{ settings.proof_image2 | image_url:width:1100 | image_tag: loading:'lazy', widths:'390,585,800,1100', sizes:'(min-width:900px) 45vw,100vw', alt:community_alt }}</button><figcaption>{{ 'dolce.sales.community_caption' | t }}</figcaption></figure>{% endif %}</div>
 </div>
</section>
{% endif %}

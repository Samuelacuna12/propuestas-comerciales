{% doc %}
Renders merchant-editable quantity offers verified against the Dolce order form.
@param {block} story - Product story block
{% enddoc %}
{% if story.settings.offer1_total > 0 %}<fieldset class="d-offers" data-dolce-offers><legend>{{ 'dolce.product.choose_offer' | t }}</legend><div class="d-offers__list">{% for i in (1..3) %}{% assign label_key = 'offer' | append:i | append:'_label' %}{% assign total_key = 'offer' | append:i | append:'_total' %}{% assign qty_key = 'offer' | append:i | append:'_quantity' %}{% assign total = story.settings[total_key] %}{% assign qty = story.settings[qty_key] %}{% if total > 0 %}<label class="d-offer"><input type="radio" name="dolce_bundle" value="{{ forloop.index0 }}" data-offer-choice data-position="{{ forloop.index0 }}" data-total="{{ total }}" data-quantity="{{ qty }}" {% if forloop.first %}checked{% endif %}><span class="d-offer__face"><span class="d-offer__title">{{ story.settings[label_key] }}</span><span class="d-offer__total">{{ total | times:100 | money | replace: ',', '.' }}</span>{% if qty > 1 %}<span class="d-offer__unit">{{ total | times:100 | divided_by:qty | money | replace: ',', '.' }} {{ 'dolce.product.each' | t }}</span>{% endif %}</span></label>{% endif %}{% endfor %}</div><p class="d-offers__note">{{ 'dolce.product.offer_confirm' | t }}</p></fieldset>{% endif %}

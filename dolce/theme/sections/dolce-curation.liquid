<section class="d-section d-wrap"><div class="d-curation-top"><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.description }}</p>{% if section.settings.link != blank %}<a href="{{ section.settings.link }}" class="d-text-link">{{ section.settings.button }}</a>{% endif %}</div><div class="d-grid">{% if section.blocks.size > 0 %}{% for block in section.blocks %}<div {{ block.shopify_attributes }}>{% if block.settings.product != blank %}{% render 'dolce-card', product:block.settings.product %}{% endif %}</div>{% endfor %}{% else %}{% for product in section.settings.collection.products limit:section.settings.count %}{% render 'dolce-card', product:product %}{% endfor %}{% endif %}</div></section>
{% schema %}
{"name":"Dolce · Selección","settings":[{"type":"text","id":"heading","label":"Título","default":"Elige cómo quieres sentirte."},{"type":"text","id":"description","label":"Descripción","default":"Encaje, transparencias y detalles que hacen la diferencia."},{"type":"text","id":"button","label":"Botón","default":"Ver todo"},{"type":"url","id":"link","label":"Destino"},{"type":"collection","id":"collection","label":"Colección de respaldo"},{"type":"range","id":"count","label":"Cantidad de respaldo","min":4,"max":12,"step":4,"default":4}],"blocks":[{"type":"product","name":"Producto elegido","settings":[{"type":"product","id":"product","label":"Producto"}]}],"presets":[{"name":"Dolce · Selección"}]}
{% endschema %}

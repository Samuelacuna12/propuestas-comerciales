<footer class="d-footer"><div class="d-wrap"><div class="d-footer-top"><div class="d-footer-brand-block"><div class="d-footer-brand">{{ section.settings.wordmark }}</div><p class="d-footer-intro">{{ section.settings.intro }}</p><a class="d-text-link" href="{{ section.settings.contact_url }}">{{ section.settings.contact_label }}</a></div><div><h3>{{ section.settings.explore_heading }}</h3><ul role="list">{% for link in section.settings.menu.links %}{% unless link.url contains "/products/tarjeta-de-regalo-dolce" %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endunless %}{% endfor %}</ul></div><div><h3>{{ section.settings.help_heading }}</h3><ul role="list">{% for policy in shop.policies %}{% if policy.body != blank %}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{% endif %}{% endfor %}{% if settings.social_instagram_link != blank %}<li><a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">Instagram</a></li>{% endif %}{% if settings.social_tiktok_link != blank %}<li><a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">TikTok</a></li>{% endif %}</ul></div></div><div class="d-footer-bottom"><span>© {{ 'now' | date:'%Y' }} {{ shop.name }}</span><span>{{ section.settings.address }}</span><span>{{ section.settings.currency_label }}</span></div></div></footer>
{% schema %}
{"name":"Dolce · Pie de página","settings":[{"type":"text","id":"wordmark","label":"Marca","default":"dolce"},{"type":"text","id":"intro","label":"Descripción","default":"Lencería para acompañarte en todas tus formas de ser."},{"type":"text","id":"contact_label","label":"Texto de contacto","default":"Hablemos por WhatsApp"},{"type":"url","id":"contact_url","label":"Contacto"},{"type":"text","id":"explore_heading","label":"Título menú","default":"Descubre Dolce"},{"type":"link_list","id":"menu","label":"Menú","default":"main-menu"},{"type":"text","id":"help_heading","label":"Título ayuda","default":"Estamos para ti"},{"type":"text","id":"address","label":"Dirección","default":"Medellín · Transversal 49 d #59-47, piso 7"},{"type":"text","id":"currency_label","label":"Moneda","default":"Colombia · COP"}]}
{% endschema %}

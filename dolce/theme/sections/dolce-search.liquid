<div class="d-wrap d-section"><h1>{{ 'dolce.search_title' | t }}</h1><form action="{{ routes.search_url }}" method="get" role="search" class="d-search-panel"><div style="display:flex;gap:12px"><label class="d-form-field" style="flex:1"><span class="d-visually-hidden">{{ 'dolce.search' | t }}</span><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.placeholder }}"></label><input type="hidden" name="type" value="product"><button class="d-button" type="submit">{{ 'dolce.search' | t }}</button></div></form>{% if search.performed %}<h2 style="font:400 1rem var(--d-body);margin-block:30px">{{ 'dolce.search_results' | t:terms:search.terms }}</h2>{% paginate search.results by 24 %}<div class="d-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'dolce-card',product:item %}{% endif %}{% else %}<p>{{ 'dolce.search_empty' | t }}</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="d-pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}{% endif %}</div>
{% schema %}{"name":"Dolce · Búsqueda","settings":[{"type":"text","id":"placeholder","label":"Texto de búsqueda","default":"Busca por nombre de prenda"}]}{% endschema %}

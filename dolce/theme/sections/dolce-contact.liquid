<div class="d-wrap d-section"><h1>{{ page.title | default:section.settings.heading }}</h1><div class="d-contact-grid"><div class="d-rich">{{ page.content }}<p>{{ section.settings.intro }}</p><a class="d-button" href="{{ section.settings.whatsapp }}">{{ section.settings.button }}</a><p style="margin-top:24px">{{ section.settings.address }}</p></div><div>{% form 'contact' %}{% if form.posted_successfully? %}<p role="status">{{ 'dolce.contact_success' | t }}</p>{% endif %}{{ form.errors | default_errors }}<label class="d-form-field">{{ 'dolce.name' | t }}<input type="text" name="contact[name]" autocomplete="name" required></label><label class="d-form-field">{{ 'dolce.email' | t }}<input type="email" name="contact[email]" autocomplete="email" required></label><label class="d-form-field">{{ 'dolce.phone' | t }}<input type="tel" name="contact[phone]" autocomplete="tel"></label><label class="d-form-field">{{ 'dolce.message' | t }}<textarea name="contact[body]" rows="5" required></textarea></label><button type="submit" class="d-button">{{ 'dolce.send' | t }}</button>{% endform %}</div></div></div>
{% schema %}{"name":"Dolce · Contacto","settings":[{"type":"text","id":"heading","label":"Título","default":"Conversemos"},{"type":"text","id":"intro","label":"Descripción","default":"¿Necesitas ayuda con tu talla o tu pedido? Escríbenos."},{"type":"text","id":"button","label":"Botón","default":"Hablar por WhatsApp"},{"type":"url","id":"whatsapp","label":"WhatsApp"},{"type":"text","id":"address","label":"Dirección","default":"Medellín · Transversal 49 d #59-47, piso 7"}]}{% endschema %}

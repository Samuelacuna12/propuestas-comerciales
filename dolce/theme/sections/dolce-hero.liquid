<style>.d-showcase{background:var(--d-paper)}.d-showcase__track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain}.d-showcase__track::-webkit-scrollbar{display:none}.d-showcase__slide{flex:0 0 100%;min-width:0;scroll-snap-align:start;height:min(860px,90svh);min-height:780px;position:relative;isolation:isolate;overflow:hidden}.d-showcase .d-cover{height:100%;min-height:0}.d-showcase__campaign{background:#171717;color:#fff}.d-showcase__ambient{position:absolute;inset:-50px;z-index:-2;background-size:cover;background-position:center;filter:blur(45px) brightness(.38);opacity:.9}.d-showcase__campaign-inner{height:100%;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:24px;padding-block:25px}.d-showcase__edition{font-size:10px;letter-spacing:.24em;margin:0}.d-showcase__art{display:block;width:100%;min-height:0}.d-showcase__art img{display:block;width:100%;height:auto;max-height:calc(90svh - 130px);object-fit:contain}.d-showcase__cta{color:white;text-underline-offset:6px;font-size:13px;padding:10px}.d-showcase__navigation{display:flex;justify-content:center;align-items:center;gap:20px;padding:12px 20px;border-bottom:1px solid var(--d-line)}.d-showcase__dots{display:flex;gap:26px;align-items:center}.d-showcase__navigation button{border:0;background:none;color:var(--d-muted);font:400 11px var(--d-body);padding:13px 5px;cursor:pointer;min-height:44px}.d-showcase__navigation button[aria-pressed=true]{color:var(--d-accent);box-shadow:0 2px var(--d-accent)}.d-showcase__navigation>button{font-size:24px;width:44px}.d-showcase__navigation button:disabled{opacity:.25;cursor:default}.d-showcase button:focus-visible,.d-showcase a:focus-visible{outline:2px solid var(--d-accent);outline-offset:3px}@media(max-width:749px){.d-showcase__slide{height:840px;min-height:0}.d-showcase__navigation{gap:6px;padding:8px 10px}.d-showcase__dots{gap:10px;flex:1;justify-content:space-around}.d-showcase__dots button{font-size:9px}.d-showcase__campaign-inner{gap:40px}.d-showcase__edition{font-size:9px}.d-showcase__art img{max-height:none}.d-showcase__cta{font-size:12px}.d-showcase__ambient{filter:blur(24px) brightness(.35)}}
</style>

{{ 'dolce-cover.css' | asset_url | stylesheet_tag }}
<script src="{{ 'dolce-cover.js' | asset_url }}" defer></script>
{% assign muse = section.settings.product_one %}
<div class="d-showcase" data-dolce-showcase aria-roledescription="carrusel" aria-label="Colecciones Dolce"><div class="d-showcase__track" data-showcase-track><div class="d-showcase__slide" data-showcase-slide>
<section class="d-cover" data-dolce-cover data-view="front" aria-label="El universo Dolce">
 <div class="d-cover__grain" aria-hidden="true"></div><p class="d-cover__eyebrow">Dolce Lingerie · La prenda y tú</p>
 <h1>Tu lado<br>más <em>Dolce.</em></h1>
 <figure class="d-cover__figure d-cover__figure--front" style="--cover-mask:url('{{ 'atelier-body-monaco-2.png' | asset_url }}')">{{ muse.images[1] | image_url: width: 1100 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '550,800,1100', sizes: '(min-width:750px) 500px,365px', alt: 'Body Mónaco Dolce, vista frontal en palo de rosa' }}</figure>
 <figure class="d-cover__figure d-cover__figure--back" style="--cover-mask:url('{{ 'atelier-body-monaco-3.png' | asset_url }}')">{{ muse.images[2] | image_url: width: 1000 | image_tag: loading: 'eager', widths: '500,750,1000', sizes: '(min-width:750px) 440px,330px', alt: 'Body Mónaco Dolce, vista posterior en palo de rosa' }}</figure>
 <span class="d-cover__vertical" aria-hidden="true">DOLCE · EN CADA DETALLE</span>
 <div class="d-cover__switch" role="group" aria-label="Explorar las vistas de Mónaco"><button type="button" data-cover-view="front" aria-pressed="true">01 · Frente</button><button type="button" data-cover-view="back" aria-pressed="false">02 · Espalda</button></div>
 <div class="d-wrap d-cover__bottom"><p>Lencería que también se convierte en tu próximo outfit.</p><div class="d-cover__buy"><div><strong>{{ muse.title | escape }}</strong><span>Descubre la prenda, de cerca.</span></div><a href="{{ muse.url }}">Explorar Mónaco ↗</a></div></div>
</section>
</div>
{% for block in section.blocks %}{% if block.settings.image != blank %}
<div class="d-showcase__slide d-showcase__campaign" data-showcase-slide {{ block.shopify_attributes }}>
 <div class="d-showcase__ambient" style="background-image:url('{{ block.settings.image | image_url: width: 900 }}')" aria-hidden="true"></div>
 <div class="d-showcase__campaign-inner"><p class="d-showcase__edition">DOLCE LINGERIE · {{ block.settings.label | escape }}</p><a class="d-showcase__art" href="{{ block.settings.link }}">{{ block.settings.image | image_url: width: 2000 | image_tag: loading:'lazy', widths:'390,585,800,1200,1600,2000', sizes:'100vw', alt:block.settings.alt }}</a><a class="d-showcase__cta" href="{{ block.settings.link }}">Explorar la colección ↗</a></div>
</div>{% endif %}{% endfor %}
</div><div class="d-showcase__navigation"><button type="button" data-showcase-prev aria-label="Diapositiva anterior">←</button><div class="d-showcase__dots" role="group" aria-label="Elegir banner"><button type="button" data-showcase-dot="0" aria-pressed="true">01 · Editorial</button>{% for block in section.blocks %}<button type="button" data-showcase-dot="{{ forloop.index }}" aria-pressed="false">0{{ forloop.index | plus: 1 }} · {{ block.settings.label | escape }}</button>{% endfor %}</div><button type="button" data-showcase-next aria-label="Siguiente diapositiva">→</button></div></div>
<script>(()=>{document.querySelectorAll('[data-dolce-showcase]').forEach(root=>{const track=root.querySelector('[data-showcase-track]'),slides=[...root.querySelectorAll('[data-showcase-slide]')],dots=[...root.querySelectorAll('[data-showcase-dot]')],prev=root.querySelector('[data-showcase-prev]'),next=root.querySelector('[data-showcase-next]');const index=()=>Math.max(0,Math.min(slides.length-1,Math.round(track.scrollLeft/track.clientWidth)));const sync=()=>{const i=index();dots.forEach((dot,n)=>dot.setAttribute('aria-pressed',String(i===n)));slides.forEach((slide,n)=>slide.inert=i!==n);prev.disabled=i===0;next.disabled=i===slides.length-1};const go=i=>{i=Math.max(0,Math.min(slides.length-1,i));slides[i].inert=false;track.scrollTo({left:i*track.clientWidth,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'})};prev.addEventListener('click',()=>go(index()-1));next.addEventListener('click',()=>go(index()+1));dots.forEach((dot,i)=>dot.addEventListener('click',()=>go(i)));dots.forEach((dot,i)=>dot.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();const n=Math.max(0,Math.min(dots.length-1,i+(e.key==='ArrowRight'?1:-1)));dots[n].focus();go(n)}}));let frame;track.addEventListener('scroll',()=>{cancelAnimationFrame(frame);frame=requestAnimationFrame(sync)},{passive:true});sync()})})();
</script>
{% schema %}
{"name": "Dolce · Portada", "settings": [{"type": "text", "id": "heading", "label": "Título", "default": "Tu forma de sentirte."}, {"type": "text", "id": "description", "label": "Descripción", "default": "Prendas que se sienten como tú. Descubre el lado más Dolce de cada día."}, {"type": "text", "id": "button", "label": "Botón", "default": "Descubrir la colección"}, {"type": "url", "id": "link", "label": "Destino"}, {"type": "text", "id": "caption", "label": "Nota editorial", "default": "Del primer detalle a tu próximo favorito."}, {"type": "product", "id": "product_one", "label": "Producto imagen principal"}, {"type": "product", "id": "product_two", "label": "Producto imagen secundaria"}, {"type": "image_picker", "id": "image_one", "label": "Imagen principal alternativa"}, {"type": "image_picker", "id": "image_two", "label": "Imagen secundaria alternativa"}], "presets": [{"name": "Dolce · Portada"}], "blocks": [{"type": "banner", "name": "Banner oficial", "settings": [{"type": "image_picker", "id": "image", "label": "Banner original"}, {"type": "text", "id": "label", "label": "Nombre corto", "default": "Colección"}, {"type": "text", "id": "alt", "label": "Descripción accesible", "default": "Dolce Lingerie"}, {"type": "url", "id": "link", "label": "Destino"}]}]}
{% endschema %}

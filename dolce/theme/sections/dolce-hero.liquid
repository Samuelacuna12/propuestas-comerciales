{% liquid
 assign image_one = section.settings.image_one | default: section.settings.product_one.featured_image
 assign image_two = section.settings.image_two | default: section.settings.product_two.featured_image
%}
<section class="d-hero"><div class="d-hero-media">{% if image_one %}{{ image_one | image_url: width:1600 | image_tag: loading:'eager', fetchpriority:'high', widths:'500,750,1000,1400,1600', sizes:'(min-width:750px) 50vw, 100vw', alt:section.settings.product_one.title }}{% endif %}{% if image_two %}{{ image_two | image_url: width:1400 | image_tag: loading:'eager', widths:'500,750,1000,1400', sizes:'50vw', alt:section.settings.product_two.title }}{% endif %}</div><div class="d-hero-content d-wrap"><div><h1>{{ section.settings.heading }}</h1><p class="d-hero-desc">{{ section.settings.description }}</p><a href="{{ section.settings.link }}" class="d-button d-button--light">{{ section.settings.button }}</a></div><p class="d-hero-caption">{{ section.settings.caption }}</p></div></section>
{% schema %}
{"name":"Dolce · Portada","settings":[{"type":"text","id":"heading","label":"Título","default":"Tu forma de sentirte."},{"type":"text","id":"description","label":"Descripción","default":"Prendas que se sienten como tú. Descubre el lado más Dolce de cada día."},{"type":"text","id":"button","label":"Botón","default":"Descubrir la colección"},{"type":"url","id":"link","label":"Destino"},{"type":"text","id":"caption","label":"Nota editorial","default":"Del primer detalle a tu próximo favorito."},{"type":"product","id":"product_one","label":"Producto imagen principal"},{"type":"product","id":"product_two","label":"Producto imagen secundaria"},{"type":"image_picker","id":"image_one","label":"Imagen principal alternativa"},{"type":"image_picker","id":"image_two","label":"Imagen secundaria alternativa"}],"presets":[{"name":"Dolce · Portada"}]}
{% endschema %}

<section class="d-section d-wrap"><div class="d-curation-top"><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.description }}</p></div><div class="d-shop-mood">{% for block in section.blocks %}{% assign mood_image = block.settings.image | default:block.settings.product.featured_image %}<a href="{{ block.settings.link | default:block.settings.product.url }}" class="d-mood" {{ block.shopify_attributes }}>{% if mood_image %}{{ mood_image | image_url:width:1000 | image_tag: loading:'lazy', widths:'400,600,800,1000', sizes:'(min-width:750px) 46vw, 46vw', alt:block.settings.heading }}{% endif %}<div class="d-mood__copy"><h3>{{ block.settings.heading }}</h3><span>{{ block.settings.button }}</span></div></a>{% endfor %}</div></section>
{% schema %}
{"name":"Dolce · Dos formas de ser","settings":[{"type":"text","id":"heading","label":"Título","default":"Para cada versión de ti."},{"type":"text","id":"description","label":"Descripción","default":"Tu estilo cambia. Tu esencia se queda."}],"blocks":[{"type":"mood","name":"Historia","settings":[{"type":"text","id":"heading","label":"Título","default":"Tu momento Dolce"},{"type":"text","id":"button","label":"Enlace","default":"Descubrir"},{"type":"url","id":"link","label":"Destino"},{"type":"product","id":"product","label":"Producto para foto"},{"type":"image_picker","id":"image","label":"Imagen alternativa"}]}],"presets":[{"name":"Dolce · Dos formas de ser"}]}
{% endschema %}

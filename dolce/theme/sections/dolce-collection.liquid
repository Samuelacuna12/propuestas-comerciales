<div class="d-wrap d-collection-page"><header class="d-collection-head"><div><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="d-rich">{{ collection.description }}</div>{% else %}<p>{{ section.settings.description }}</p>{% endif %}</div></header><form class="d-toolbar" method="get"><details><summary>{{ 'dolce.filter' | t }}</summary><div class="d-filter-panel">{% for filter in collection.filters %}<fieldset><legend>{{ filter.label }}</legend>{% case filter.type %}{% when 'boolean' or 'list' %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>{{ value.label }} ({{ value.count }})</label>{% endfor %}{% when 'price_range' %}<label>{{ filter.min_value.label }}<input type="number" name="{{ filter.min_value.param_name }}" min="0" placeholder="0" {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by:100.0 }}"{% endif %}></label><label>{{ filter.max_value.label }}<input type="number" name="{{ filter.max_value.param_name }}" min="0" placeholder="{{ filter.range_max | divided_by:100.0 }}" {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by:100.0 }}"{% endif %}></label>{% endcase %}</fieldset>{% endfor %}<button type="submit" class="d-button">{{ 'dolce.apply' | t }}</button> <a href="{{ collection.url }}">{{ 'dolce.clear' | t }}</a></div></details><span>{{ 'dolce.products_count' | t:count:collection.products_count }}</span><label><span class="d-visually-hidden">{{ 'dolce.sort' | t }}</span><select name="sort_by" data-autosubmit>{% assign sort_by = collection.sort_by | default:collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></label><noscript><button type="submit">{{ 'dolce.apply' | t }}</button></noscript></form>{% paginate collection.products by 24 %}<div class="d-grid">{% for product in collection.products %}{% render 'dolce-card',product:product %}{% else %}<div class="d-empty"><p>{{ 'dolce.empty' | t }}</p><a class="d-button" href="{{ routes.all_products_collection_url }}">{{ 'dolce.all_products' | t }}</a></div>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="d-pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}</div>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":{{ shop.name | json }},"item":{{ shop.url | json }}},{"@type":"ListItem","position":2,"name":{{ collection.title | json }},"item":{{ canonical_url | json }}}]}</script>
{% schema %}
{"name":"Dolce · Colección","settings":[{"type":"text","id":"description","label":"Descripción de respaldo","default":"Encuentra las prendas que acompañan tu forma de ser."}]}
{% endschema %}

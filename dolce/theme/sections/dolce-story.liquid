<section class="d-section d-wrap"><div class="d-story"><div class="d-story__image">{% if section.settings.image %}{{ section.settings.image | image_url:width:1200 | image_tag: loading:'lazy', widths:'400,700,1000,1200', sizes:'(min-width:750px) 45vw, 100vw', alt:section.settings.image_alt }}{% elsif section.settings.product.featured_image %}{{ section.settings.product.featured_image | image_url:width:1200 | image_tag:loading:'lazy', alt:section.settings.product.title }}{% endif %}</div><div class="d-story__copy" data-reveal><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.description }}</p><a href="{{ section.settings.link }}" class="d-text-link">{{ section.settings.button }}</a></div></div></section>
{% schema %}
{"name":"Dolce · La marca","settings":[{"type":"text","id":"heading","label":"Título","default":"Lo más bonito es sentirte tú."},{"type":"text","id":"description","label":"Descripción","default":"Dolce es ese detalle que eliges para ti. Explora texturas, colores y siluetas; si necesitas ayuda para encontrar la tuya, estamos a un mensaje."},{"type":"text","id":"button","label":"Botón","default":"Conversemos"},{"type":"url","id":"link","label":"Destino"},{"type":"image_picker","id":"image","label":"Imagen ambiental"},{"type":"text","id":"image_alt","label":"Descripción de imagen","default":"Composición editorial de encaje negro y satén rosa"},{"type":"product","id":"product","label":"Producto de respaldo"}],"presets":[{"name":"Dolce · La marca"}]}
{% endschema %}

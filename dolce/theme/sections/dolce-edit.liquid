{% assign edit_image = section.settings.image | default:section.settings.product.featured_image %}
<section class="d-edit"><div class="d-edit__image">{% if edit_image %}{{ edit_image | image_url: width:1400 | image_tag: loading:'lazy', widths:'500,750,1000,1400', sizes:'(min-width:750px) 55vw, 100vw', alt:section.settings.product.title }}{% endif %}</div><div class="d-edit__content" data-reveal><p class="d-kicker">{{ section.settings.label }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.description }}</p><a class="d-button d-button--outline" href="{{ section.settings.link | default:section.settings.product.url }}">{{ section.settings.button }}</a>{% if section.settings.secondary_product != blank %}<a class="d-edit__product" href="{{ section.settings.secondary_product.url }}">{{ section.settings.secondary_product.featured_image | image_url:width:250 | image_tag: loading:'lazy', alt:section.settings.secondary_product.title }}<div><strong>{{ section.settings.secondary_product.title }}</strong><span>{{ section.settings.secondary_product.price | money | replace: ',', '.' }}</span><span>{{ section.settings.secondary_label }}</span></div></a>{% endif %}</div></section>
{% schema %}
{"name":"Dolce · Editorial","settings":[{"type":"text","id":"label","label":"Etiqueta","default":"Dentro y fuera"},{"type":"text","id":"heading","label":"Título","default":"Demasiado lindo para esconderlo."},{"type":"text","id":"description","label":"Descripción","default":"Un body, tu jean favorito y ganas de salir. Descubre prendas que también se vuelven parte de tu outfit."},{"type":"text","id":"button","label":"Botón","default":"Explorar bodys"},{"type":"url","id":"link","label":"Destino"},{"type":"product","id":"product","label":"Producto principal"},{"type":"image_picker","id":"image","label":"Foto editorial alternativa"},{"type":"product","id":"secondary_product","label":"Producto complementario"},{"type":"text","id":"secondary_label","label":"Texto secundario","default":"Descubrir la prenda"}],"presets":[{"name":"Dolce · Editorial"}]}
{% endschema %}

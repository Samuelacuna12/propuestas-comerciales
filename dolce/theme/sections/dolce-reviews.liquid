<style>
.dr{--wine:#571e32;--ink:#30262a;--paper:#f6f0e9;color:var(--ink);background:var(--paper);padding:80px max(24px,calc((100vw - 1280px)/2));font-family:Poppins,Arial,sans-serif;overflow:hidden}.dr[hidden]{display:none}.dr__intro{display:flex;justify-content:space-between;align-items:end;gap:32px;margin-bottom:36px}.dr__eyebrow{font-size:10px;letter-spacing:.19em;margin:0 0 18px}.dr h2{font:400 clamp(42px,5vw,72px)/1.03 Georgia,serif;letter-spacing:-.04em;margin:0}.dr h2 em{font-weight:400;color:var(--wine)}.dr__rating{display:flex;align-items:center;gap:20px;padding-bottom:8px}.dr__rating>span{font:400 64px/1 Georgia,serif;letter-spacing:-.05em}.dr__stars{color:var(--wine);letter-spacing:4px;font-size:15px}.dr__rating p{font-size:12px;margin:5px 0}.dr__rating small{font-size:10px;color:#73676b}.dr__feature{display:grid;grid-template-columns:.85fr 1.15fr;min-height:400px;background:#eee2d8}.dr__photo{position:relative;max-height:490px;overflow:hidden;background:#ddd0c4}.dr__photo img{width:100%;height:100%;object-fit:cover;object-position:center 64%;display:block}.dr__photo>span{position:absolute;bottom:20px;left:20px;color:#fff;background:#30262ad9;border:1px solid #ffffff60;padding:8px 12px;font-size:10px;letter-spacing:.06em}.dr__quote{padding:42px clamp(24px,4vw,64px);display:flex;flex-direction:column;justify-content:center;align-items:start}.dr blockquote{margin:22px 0 28px;font:400 clamp(26px,3vw,42px)/1.22 Georgia,serif;letter-spacing:-.02em}.dr__person{font-size:13px;display:flex;gap:12px;align-items:center}.dr__initial{display:grid;place-items:center;background:#e7d7d1;color:var(--wine);width:38px;height:38px;border-radius:50%;font:18px Georgia,serif}.dr__person strong{font-weight:500}.dr__person small{display:block;font-size:10px;color:#65595d;margin-top:4px}.dr__verified{font-size:10px;color:var(--wine);border-bottom:1px solid #c5aea9;padding-bottom:3px;margin-top:12px}.dr__product{font-size:10px;color:#65595d;margin:15px 0 0;text-decoration:none}.dr__video{display:inline-flex;gap:10px;align-items:center;border:1px solid var(--wine);border-radius:0;color:var(--wine);background:transparent;padding:12px 18px;font:11px Poppins,Arial,sans-serif;margin-top:24px;cursor:pointer}.dr__video:hover{color:white;background:var(--wine)}.dr__bar{display:flex;align-items:center;justify-content:space-between;margin:38px 0 20px}.dr__bar p{font:24px Georgia,serif;margin:0}.dr__bar strong{font-weight:400;font-style:italic;color:var(--wine)}.dr__bar p span{display:block;font:10px Poppins,Arial,sans-serif;margin-top:8px;color:#65595d}.dr__controls{display:flex;gap:8px}.dr__controls button{width:42px;height:42px;border:1px solid #baa7a5;background:transparent;color:var(--wine);border-radius:50%;font-size:22px;cursor:pointer}.dr__controls button:hover{background:#e8dbd1}.dr__controls button:disabled{opacity:.3;cursor:default}.dr__rail{display:flex;overflow-x:auto;gap:16px;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:#b69a97 transparent;padding:0 0 16px;overscroll-behavior-x:contain}.dr__card{flex:0 0 calc((100% - 32px)/3);scroll-snap-align:start;background:#fffaf5;box-sizing:border-box;padding:28px;display:flex;flex-direction:column;min-height:290px;border-top:1px solid #cfbcb5}.dr__card>p{font:19px/1.55 Georgia,serif;margin:20px 0 28px;flex:1}.dr__card .dr__stars{font-size:12px;letter-spacing:3px}.dr__note{font-size:10px;line-height:1.8;color:#73676b;max-width:850px;margin:18px 0 0}.dr__note a{color:var(--wine);white-space:nowrap}.dr__dialog{padding:44px 16px 16px;border:0;background:#f6f0e9;max-width:90vw;width:460px;max-height:90dvh;overflow:auto}.dr__dialog::backdrop{background:#20151bd9}.dr__dialog button{position:absolute;right:12px;top:5px;font-size:25px;border:0;background:none;color:var(--wine);cursor:pointer;width:36px;height:36px}.dr__dialog iframe{display:block;width:100%;height:min(65dvh,610px);border:0;background:#21181c}.dr__dialog p{font:12px Poppins,Arial,sans-serif}.dr :focus-visible{outline:2px solid var(--wine);outline-offset:4px}
@media(max-width:749px){.dr{padding:48px 20px}.dr__intro{display:block;margin-bottom:26px}.dr__eyebrow{font-size:9px;letter-spacing:.12em}.dr h2{font-size:46px}.dr__rating{margin-top:24px;gap:14px}.dr__rating>span{font-size:44px}.dr__rating small{font-size:9px}.dr__feature{grid-template-columns:1fr}.dr__photo{height:330px}.dr__photo img{object-position:center 68%}.dr__photo>span{bottom:16px;left:16px}.dr__quote{padding:28px 24px 32px}.dr blockquote{font-size:30px;margin:20px 0 24px}.dr__bar{margin:30px 0 18px;gap:12px}.dr__bar p{font-size:23px}.dr__controls{gap:6px}.dr__controls button{width:36px;height:36px}.dr__rail{margin-right:-20px;padding-right:20px;scroll-padding-left:0}.dr__card{flex-basis:84%;padding:24px;min-height:290px}.dr__card>p{font-size:20px}.dr__note{font-size:9px;margin-top:12px}}
@media(prefers-reduced-motion:no-preference){.dr__rail{scroll-behavior:smooth}.dr__video,.dr__controls button{transition:background .2s,color .2s}}
</style>
<script>
(()=>{const root=document.getElementById('dolce-reviews-{{ section.id }}');if(!root||root.dataset.ready)return;root.dataset.ready='true';
const read=el=>{let v=JSON.parse(el.textContent);for(let n=0;typeof v==='string'&&n<3;n++){const t=document.createElement('textarea');t.innerHTML=v;v=JSON.parse(t.value)}return v};let data;try{data=read(root.querySelector('[data-dr-source]'))}catch{}if(!data?.reviews){try{data=read(root.querySelector('[data-dr-snapshot]'))}catch{return}}
const rows=[...Object.values(data.reviews||{}).flat(),...(data.product?.review_ugc||[])];const unique=[...new Map(rows.filter(r=>r&&r.id).map(r=>[r.id,r])).values()];const selected=unique.filter(r=>Number(r.star_rating)===5&&r.region==='CO');if(!selected.length)return;
const el=(tag,cls,text)=>{const n=document.createElement(tag);if(cls)n.className=cls;if(text)n.textContent=text;return n};const stars=()=>{const s=el('span','dr__stars','★★★★★');s.setAttribute('aria-label','5 de 5 estrellas');return s};
const person=r=>{const wrap=el('div','dr__person');wrap.append(el('span','dr__initial',(r.user_name||'C').trim()[0]));const who=el('div');who.append(el('strong','',r.user_name||'Clienta Dolce'),el('small','','Colombia'));wrap.append(who);return wrap};
const product=r=>el('p','dr__product',r.product_name||'Compra en Dolce');const verified=(node,r)=>{if(r.verified_review===true)node.append(el('span','dr__verified','✓ Compra verificada'))};
const video=(node,r)=>{if(!r.video)return;let url;try{url=new URL(r.video);if(url.protocol!=='https:'||url.hostname!=='videos.sproutvideo.com'||!url.pathname.startsWith('/embed/'))return}catch{return}const button=el('button','dr__video','▷ Ver video de '+r.user_name);button.type='button';button.addEventListener('click',()=>{const dialog=el('dialog','dr__dialog');const close=el('button','','×');close.type='button';close.setAttribute('aria-label','Cerrar video');const frame=el('iframe');frame.src=url.href;frame.title='Video de la reseña de '+r.user_name;frame.allow='fullscreen';frame.setAttribute('allowfullscreen','');dialog.append(close,frame,el('p','',r.user_name+' · '+r.product_name));document.body.append(dialog);close.onclick=()=>dialog.close();dialog.addEventListener('close',()=>{dialog.remove();button.focus()});dialog.showModal();close.focus()});node.append(button)};
const featured=selected.find(r=>r.image_urls?.some(u=>u.startsWith('https://cdn.opinew.com/review-images/')));if(featured){const target=root.querySelector('[data-dr-feature]');const photo=el('div','dr__photo');const img=el('img');img.src=featured.image_urls.find(u=>u.startsWith('https://cdn.opinew.com/review-images/'));img.alt='Foto del pedido compartida por '+featured.user_name;img.loading='lazy';img.width=337;img.height=600;photo.append(img,el('span','','FOTO DE UNA COMPRA REAL'));const quote=el('div','dr__quote');quote.append(stars(),el('blockquote','','“'+featured.body+'”'),person(featured));verified(quote,featured);quote.append(product(featured));video(quote,featured);target.append(photo,quote)}else root.querySelector('[data-dr-feature]').hidden=true;
const rail=root.querySelector('[data-dr-rail]');selected.filter(r=>r!==featured).slice(0,6).forEach(r=>{const card=el('article','dr__card');card.append(stars(),el('p','','“'+r.body+'”'),person(r));verified(card,r);card.append(product(r));video(card,r);rail.append(card)});
const average=Number(data.product?.average_stars);const total=Number(data.product?.review_number);if(average>0&&total>0){root.querySelector('[data-dr-average]').textContent=average.toLocaleString('es-CO',{maximumFractionDigits:1})+'/5';root.querySelector('[data-dr-total]').textContent=total+' opiniones en Dolce'}else root.querySelector('.dr__rating').hidden=true;
const prev=root.querySelector('[data-dr-prev]'),next=root.querySelector('[data-dr-next]');const state=()=>{prev.disabled=rail.scrollLeft<4;next.disabled=rail.scrollLeft+rail.clientWidth>=rail.scrollWidth-4};prev.onclick=()=>rail.scrollBy({left:-rail.clientWidth*.88});next.onclick=()=>rail.scrollBy({left:rail.clientWidth*.88});rail.addEventListener('scroll',state,{passive:true});root.hidden=false;new ResizeObserver(state).observe(rail);state();
})();
</script>

<div class="d-wrap d-section"><h1>{{ 'dolce.cart_title' | t }}</h1>{% if cart.empty? %}<div class="d-empty"><p>{{ 'dolce.cart_empty' | t }}</p><a class="d-button" href="{{ routes.all_products_collection_url }}">{{ 'dolce.continue_shopping' | t }}</a></div>{% else %}{% form 'cart',cart %}{% for item in cart.items %}<article class="d-cart-line"><a href="{{ item.url }}">{{ item.image | image_url:width:250 | image_tag:loading:'lazy',alt:item.product.title }}</a><div><h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2><p>{{ item.variant.title }}</p><a href="{{ item.url_to_remove }}">{{ 'dolce.remove' | t }}</a></div><label><span class="d-visually-hidden">{{ 'dolce.quantity' | t }} · {{ item.product.title }}</span><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="1"></label><div>{{ item.final_line_price | money | replace: ',', '.' }}</div></article>{% endfor %}<div class="d-cart-total"><strong><span>{{ 'dolce.subtotal' | t }}</span><span>{{ cart.total_price | money | replace: ',', '.' }}</span></strong><div style="background-color:#fff">{{ form | payment_terms }}</div><p>{{ 'dolce.shipping_note' | t }}</p><button class="d-button d-button--outline" type="submit" name="update">{{ 'dolce.update_cart' | t }}</button><button class="d-button" type="submit" name="checkout">{{ 'dolce.checkout' | t }}</button></div>{% endform %}{% endif %}</div>
{% schema %}{"name":"Dolce · Bolsa","settings":[]}{% endschema %}

<section class="d-wrap d-section"><div class="d-film"><div class="d-film__media">{% if section.settings.video_source != blank %}<video controls playsinline preload="none" {% if section.settings.poster %}poster="{{ section.settings.poster | image_url:width:650 }}"{% endif %} aria-label="{{ section.settings.heading | escape }}"><source src="{{ section.settings.video_source }}" type="video/mp4"></video>{% endif %}</div><div class="d-film__copy"><p class="d-kicker">{{ section.settings.label }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.description }}</p><a href="{{ section.settings.collection.url }}" class="d-button d-button--outline">{{ section.settings.button }}</a><a href="{{ section.settings.source }}" class="d-text-link" target="_blank" rel="noopener">{{ section.settings.source_label }}</a></div></div></section>
{% schema %}{"name":"Dolce · Detrás de cámaras","settings":[{"type":"text","id":"label","label":"Etiqueta","default":"Detrás de cámaras"},{"type":"text","id":"heading","label":"Título","default":"Antes de tu próximo favorito."},{"type":"text","id":"description","label":"Descripción","default":"Una mirada a una sesión de Dolce. Prendas reales, detalles y el trabajo que hay detrás de cada foto."},{"type":"url","id":"video_source","label":"Video MP4 oficial"},{"type":"image_picker","id":"poster","label":"Portada del video"},{"type":"collection","id":"collection","label":"Colección"},{"type":"text","id":"button","label":"Botón","default":"Explorar Dolce"},{"type":"url","id":"source","label":"Publicación original"},{"type":"text","id":"source_label","label":"Texto de la fuente","default":"Ver publicación oficial"}],"presets":[{"name":"Dolce · Detrás de cámaras"}]}{% endschema %}

<div class="d-announcement">{{ section.settings.announcement }}</div>
<div class="d-header-shell"><header class="d-header d-wrap"><div><nav class="d-header-nav" aria-label="{{ 'dolce.navigation' | t }}">{% for link in section.settings.menu.links limit:5 %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</nav><details class="d-nav-mobile"><summary class="d-icon-button" aria-label="{{ 'dolce.menu' | t }}">{% render 'dolce-icon', name:'menu' %}</summary><nav class="d-mobile-links" aria-label="{{ 'dolce.navigation' | t }}">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}<a href="{{ section.settings.contact_link }}">{{ section.settings.contact_label }}</a></nav></details></div><a href="{{ routes.root_url }}" class="d-logo" aria-label="{{ shop.name }}">{% if settings.logo %}{{ settings.logo | image_url: width: 400 | image_tag: widths: '140,280,400', sizes:'135px', alt: shop.name }}{% else %}<span class="d-logo-text">{{ section.settings.wordmark }}</span>{% endif %}</a><div class="d-header-actions"><button class="d-icon-button" type="button" data-search-toggle aria-controls="DolceSearch" aria-expanded="false" aria-label="{{ 'dolce.search' | t }}">{% render 'dolce-icon', name:'search' %}</button><a href="{{ routes.cart_url }}" class="d-icon-button" aria-label="{{ 'dolce.cart' | t }}">{% render 'dolce-icon', name:'bag' %}<span class="d-cart-label">&nbsp;(<span data-cart-count>{{ cart.item_count }}</span>)</span></a></div></header><div id="DolceSearch" class="d-search-panel" data-search-panel hidden><form class="d-wrap" action="{{ routes.search_url }}" method="get" role="search"><label><span class="d-visually-hidden">{{ 'dolce.search' | t }}</span><input type="search" name="q" placeholder="{{ section.settings.search_hint }}" value="{{ search.terms | escape }}"></label><input type="hidden" name="type" value="product"><button class="d-button" type="submit">{{ 'dolce.search' | t }}</button></form></div></div>
{% schema %}
{"name":"Dolce · Cabecera","class":"d-header-section","settings":[{"type":"text","id":"announcement","label":"Anuncio","default":"Dolce Lingerie · Diseñada para sentirte tú"},{"type":"text","id":"wordmark","label":"Marca de respaldo","default":"dolce"},{"type":"link_list","id":"menu","label":"Menú","default":"main-menu"},{"type":"text","id":"contact_label","label":"Asesoría","default":"Te ayudamos a elegir"},{"type":"url","id":"contact_link","label":"Enlace de asesoría"},{"type":"text","id":"search_hint","label":"Texto búsqueda","default":"Busca tu próximo favorito"}]}
{% endschema %}
